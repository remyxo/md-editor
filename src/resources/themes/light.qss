/* 亮色主题 — 现代化扁平风格 */
QMainWindow {
    background-color: #f5f5f5;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    padding: 2px 0;
    font-size: 13px;
    color: #333333;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
    margin: 2px 2px;
    color: #333333;
}

QMenuBar::item:selected {
    background-color: #e8e8e8;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 4px 0;
    color: #333333;
}

QMenu::item {
    padding: 6px 32px 6px 16px;
    font-size: 13px;
    color: #333333;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #e0e0e0;
    margin: 4px 8px;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    padding: 6px 10px;
    spacing: 6px;
}

QLabel#headingLabel {
    color: #555;
    font-size: 15px;
}

QToolBar::separator {
    width: 1px;
    margin: 4px 6px;
    background-color: #d8d8d8;
}

QToolButton {
    border: none;
    border-radius: 5px;
    padding: 7px 10px;
    font-size: 16px;
    color: #444444;
    min-width: 24px;
}

QToolButton:hover {
    background-color: #e8e8e8;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #d0d0d0;
}

/* 文本格式 — SVG 图标的彩色（stroke="currentColor"） */
QToolButton#boldAction      { color: #1a73e8; }
QToolButton#italicAction    { color: #0d904f; }
QToolButton#strikeAction    { color: #d93025; }
QToolButton#codeAction      { color: #e37400; }
QToolButton#underlineAction { color: #7b1fa2; }
QToolButton#highlightAction { color: #f9ab00; }

/* 结构按钮 — 深灰图标 */
QToolButton#bulletListAction,
QToolButton#orderedListAction,
QToolButton#taskListAction,
QToolButton#blockquoteAction { color: #5f6368; }

/* 插入按钮 — 蓝色调图标 */
QToolButton#linkAction,
QToolButton#imageAction,
QToolButton#tableAction,
QToolButton#hrAction { color: #1967d2; }

/* 视图/导出 */
QToolButton#sourceAction { color: #5f6368; }
QToolButton#pdfAction    { color: #d93025; }

/* checked 状态：背景高亮，保留彩色图标 */
QToolButton:checked {
    background-color: #cce0f5;
}

QTreeView {
    background-color: #ffffff;
    border: none;
    font-size: 13px;
    color: #333333;
}

QTreeView::item {
    padding: 4px 8px;
    border-radius: 4px;
    color: #333333;
}

QTreeView::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QTreeView::item:hover:!selected {
    background-color: #e8e8e8;
}

QTabWidget::pane {
    border: none;
    background-color: #f5f5f5;
}

QTabBar::tab {
    background-color: #e8e8e8;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    margin: 2px 2px;
    font-size: 13px;
    color: #333333;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #111111;
}

QTabBar::tab:hover:!selected {
    background-color: #dcdcdc;
    color: #333333;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
    font-size: 12px;
    color: #666666;
    padding: 2px 8px;
}

QSplitter::handle {
    background-color: #e0e0e0;
    width: 1px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* 对话框和表单控件 */
QDialog {
    background-color: #ffffff;
}

QLabel {
    color: #333333;
}

QGroupBox {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-size: 13px;
    color: #333333;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #333333;
}

QCheckBox {
    color: #333333;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    color: #333333;
    font-size: 13px;
    min-width: 80px;
}

QComboBox:hover {
    border-color: #0078d4;
}

QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    color: #333333;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QSpinBox, QFontComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    color: #333333;
    font-size: 13px;
}

QSpinBox:hover, QFontComboBox:hover {
    border-color: #0078d4;
}

QPushButton {
    background-color: #f0f0f0;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px 16px;
    color: #333333;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #e0e0e0;
    border-color: #0078d4;
}

QPushButton:pressed {
    background-color: #d0d0d0;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    color: #333333;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #0078d4;
}

QTabWidget QWidget {
    background-color: #ffffff;
}
