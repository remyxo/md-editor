/* 暗色主题 — 现代化扁平风格 */
QMainWindow {
    background-color: #1e1e1e;
}

QMenuBar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3d3d3d;
    padding: 2px 0;
    font-size: 13px;
    color: #cccccc;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
    margin: 2px 2px;
}

QMenuBar::item:selected {
    background-color: #3d3d3d;
}

QMenu {
    background-color: #2d2d2d;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    padding: 4px 0;
    color: #cccccc;
}

QMenu::item {
    padding: 6px 32px 6px 16px;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #3d3d3d;
    margin: 4px 8px;
}

QToolBar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #383838;
    padding: 6px 10px;
    spacing: 6px;
}

QLabel#headingLabel {
    color: #c4c9ce;
    font-size: 15px;
}

QToolBar::separator {
    width: 1px;
    margin: 4px 6px;
    background-color: #3d3d3d;
}

QToolButton {
    border: none;
    border-radius: 5px;
    padding: 7px 10px;
    font-size: 16px;
    min-width: 24px;
}

QToolButton:hover {
    background-color: #3d3d3d;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #4d4d4d;
}

/* 文本格式 — 暗色 SVG 图标彩色 */
QToolButton#boldAction      { color: #8ab4f8; }
QToolButton#italicAction    { color: #81c995; }
QToolButton#strikeAction    { color: #f28b82; }
QToolButton#codeAction      { color: #fbbc04; }
QToolButton#underlineAction { color: #c58af9; }
QToolButton#highlightAction { color: #fdd663; }

/* 结构按钮 */
QToolButton#bulletListAction,
QToolButton#orderedListAction,
QToolButton#taskListAction,
QToolButton#blockquoteAction { color: #c4c9ce; }

/* 插入按钮 */
QToolButton#linkAction,
QToolButton#imageAction,
QToolButton#tableAction,
QToolButton#hrAction { color: #8ab4f8; }

/* 视图/导出 */
QToolButton#sourceAction { color: #c4c9ce; }
QToolButton#pdfAction    { color: #f28b82; }

/* checked 状态：背景高亮 */
QToolButton:checked {
    background-color: #1a3a5c;
}

QTreeView {
    background-color: #252526;
    border: none;
    font-size: 13px;
    color: #cccccc;
}

QTreeView::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QTreeView::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QTreeView::item:hover:!selected {
    background-color: #2a2d2e;
}

QTabWidget {
    border: none;
}
QTabWidget::pane {
    border: 1px solid #333;
    border-top: none;
    background-color: #1e1e1e;
}

QTabBar::tab {
    background-color: #2d2d2d;
    border: 1px solid #333;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 6px 16px;
    margin: 2px 2px 0 2px;
    font-size: 13px;
    color: #999999;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    border-bottom: 1px solid #1e1e1e;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #3d3d3d;
}

QStatusBar {
    background-color: #2d2d2d;
    border-top: 1px solid #3d3d3d;
    font-size: 12px;
    color: #999999;
    padding: 2px 8px;
}

QMainWindow::separator {
    width: 1px;
    background: #333;
}
QSplitter::handle {
    background-color: #333;
    width: 1px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #424242;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* 对话框和表单控件 — 暗色 */
QDialog { background-color: #2d2d2d; }
QLabel { color: #cccccc; }

QGroupBox {
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-size: 13px;
    color: #cccccc;
}

QGroupBox::title {
    left: 12px;
    padding: 0 6px;
    color: #cccccc;
}

QCheckBox { color: #cccccc; spacing: 8px; }

QComboBox, QSpinBox, QFontComboBox {
    background-color: #3d3d3d;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cccccc;
    font-size: 13px;
}

QComboBox:hover, QSpinBox:hover, QFontComboBox:hover { border-color: #8ab4f8; }
QComboBox QAbstractItemView {
    background-color: #3d3d3d;
    color: #cccccc;
    selection-background-color: #094771;
}

QPushButton {
    background-color: #3d3d3d;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 6px 16px;
    color: #cccccc;
    font-size: 13px;
}
QPushButton:hover { background-color: #4d4d4d; border-color: #8ab4f8; }
QPushButton:pressed { background-color: #555; }

QLineEdit {
    background-color: #3d3d3d;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cccccc;
    font-size: 13px;
}
QLineEdit:focus { border-color: #8ab4f8; }
