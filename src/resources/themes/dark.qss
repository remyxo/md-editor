/* 暗色主题 — 现代化扁平风格 */
QMainWindow {
    background-color: #1e1e1e;
    border: none;
}
QMainWindow::separator {
    width: 0;
    height: 0;
}

QMenuBar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3d3d3d;
    padding: 2px 0;
    font-size: 13px;
    color: #cccccc;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
    margin: 2px 2px;
}

QMenuBar::item:selected {
    background-color: #3d3d3d;
}

QMenu {
    background-color: #2d2d2d;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    padding: 4px 0;
    color: #cccccc;
}

QMenu::item {
    padding: 6px 32px 6px 16px;
    font-size: 13px;
}

/* 菜单项图标：左侧留几个像素，避免紧贴菜单边缘 */
QMenu::icon {
    left: 6px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #3d3d3d;
    margin: 4px 8px;
}

QToolBar {
    background-color: #2d2d2d;
    border-bottom: none;
    padding: 4px 6px;
    spacing: 3px;
}

QLabel#headingLabel {
    color: #c4c9ce;
    font-size: 15px;
}

QToolBar::separator {
    width: 1px;
    margin: 2px 4px;
    background-color: #3d3d3d;
}

QToolButton {
    border: none;
    border-radius: 5px;
    padding: 4px 6px;
    font-size: 16px;
    min-width: 24px;
}

QToolButton:hover {
    background-color: #3d3d3d;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #4d4d4d;
}

/* 侧边栏面板标题栏（CollapsibleSection）：显式亮色文字，与暗色正文文字标准一致 */
QToolButton#collapsibleHeader {
    color: #cccccc;
}


/* 文本格式 — 暗色 SVG 图标彩色 */
QToolButton#boldAction      { color: #8ab4f8; }
QToolButton#italicAction    { color: #81c995; }
QToolButton#strikeAction    { color: #f28b82; }
QToolButton#codeAction      { color: #fbbc04; }
QToolButton#underlineAction { color: #c58af9; }
QToolButton#highlightAction { color: #fdd663; }

/* 结构按钮 */
QToolButton#bulletListAction,
QToolButton#orderedListAction,
QToolButton#taskListAction,
QToolButton#blockquoteAction { color: #c4c9ce; }

/* 插入按钮 */
QToolButton#linkAction,
QToolButton#imageAction,
QToolButton#tableAction,
QToolButton#hrAction,
QToolButton#footnoteAction { color: #8ab4f8; }

/* 视图/导出 */
QToolButton#sourceAction { color: #c4c9ce; }
QToolButton#pdfAction    { color: #f28b82; }
QToolButton#pdfAction::menu-indicator {
    image: url(:/icons/dark/chevron-down.svg);
    subcontrol-position: right bottom;
    subcontrol-origin: margin;
    bottom: 4px;
    right: 2px;
    width: 8px;
    height: 5px;
}

/* 对齐/上下标下拉按钮 — 浅灰图标，chevron 同导出规格 */
QToolButton#alignButton,
QToolButton#subsupButton { color: #c4c9ce; }
QToolButton#alignButton::menu-indicator,
QToolButton#subsupButton::menu-indicator {
    image: url(:/icons/dark/chevron-down.svg);
    subcontrol-position: right bottom;
    subcontrol-origin: margin;
    bottom: 4px;
    right: 2px;
    width: 8px;
    height: 5px;
}

/* checked 状态：背景高亮 */
QToolButton:checked {
    background-color: #1a3a5c;
}

QTreeView {
    background-color: #252526;
    border: none;
    font-size: 14px;
    color: #cccccc;
}

QTreeView::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QTreeView::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QTreeView::item:hover:!selected {
    background-color: #2a2d2e;
}

QTabWidget {
    border: none;
}
QTabWidget::pane {
    border: 1px solid #333;
    border-top: none;
    background-color: #1e1e1e;
}

QTabBar {
    background-color: #2d2d2d;
}
QTabBar::tab {
    background-color: #333;
    border: 1px solid #444;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 6px 16px;
    margin: 2px 2px 0 2px;
    font-size: 13px;
    color: #999999;
}

QTabBar::tab:selected {
    background-color: #2d2d2d;
    border-bottom: 1px solid #2d2d2d;
    color: #fff;
}

QTabBar::tab:hover:!selected {
    background-color: #3d3d3d;
    color: #bbb;
}

QTabBar::tab:!selected {
    color: #999;
}

QStatusBar {
    background-color: #2d2d2d;
    border-top: 1px solid #3d3d3d;
    font-size: 12px;
    color: #999999;
    padding: 2px 8px;
}

QMainWindow::separator {
    width: 1px;
    background: #333;
}
QSplitter::handle {
    background-color: #333;
    width: 1px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #424242;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* 对话框和表单控件 — 暗色 */
QDialog { background-color: #2d2d2d; }
QLabel { color: #cccccc; }

QGroupBox {
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-size: 13px;
    color: #cccccc;
}

QGroupBox::title {
    left: 12px;
    padding: 0 6px;
    color: #cccccc;
}

QCheckBox { color: #cccccc; spacing: 8px; }

QComboBox, QSpinBox, QFontComboBox {
    background-color: #3d3d3d;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cccccc;
    font-size: 13px;
}

QComboBox:hover, QSpinBox:hover, QFontComboBox:hover { border-color: #8ab4f8; }
QComboBox QAbstractItemView {
    background-color: #3d3d3d;
    color: #cccccc;
    selection-background-color: #094771;
}

QPushButton {
    background-color: #3d3d3d;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 6px 16px;
    color: #cccccc;
    font-size: 13px;
}
QPushButton:hover { background-color: #4d4d4d; border-color: #8ab4f8; }
QPushButton:pressed { background-color: #555; }

QPushButton:checked {
    background-color: #1e3a5f;
    border: 2px solid #8ab4f8;
    color: #8ab4f8;
}

QLineEdit {
    background-color: #3d3d3d;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cccccc;
    font-size: 13px;
}
QLineEdit:focus { border-color: #8ab4f8; }

/* kbd 键盘按键（web 编辑器内样式见 editor.css） */

/* 搜索栏：导航/关闭等小按钮（全局 QPushButton padding 6px 16px 会挤爆窄按钮） */
#searchBar QPushButton {
    padding: 4px 6px;
}
